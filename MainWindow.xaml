<Window x:Class="QuickQR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickQR - Instant QR Code &amp; Live Clipboard"
        Width="860" Height="520"
        MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#121214"
        Foreground="#ECECEF"
        FontFamily="Segoe UI, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Palette et Couleurs Globales -->
        <SolidColorBrush x:Key="BgDark" Color="#121214"/>
        <SolidColorBrush x:Key="BgCard" Color="#1C1C1F"/>
        <SolidColorBrush x:Key="BorderCard" Color="#2C2C32"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8E98"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>

        <!-- Style des Boutons Standards -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252529"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323238"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C4C58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox Thème Sombre Complet (Zéro Blanc sur Blanc) -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2E2E36"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#252529"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="#252529"
                                                BorderBrush="#383842"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#8E8E98"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#323238"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#4C4C58"/>
                                                <Setter TargetName="arrow" Property="Fill" Value="#ECECEF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,5,26,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1C1C1F"
                                            BorderBrush="#383842"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ProgressBar Densité -->
        <Style x:Key="DensityProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#252529"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" 
                                    Background="{TemplateBinding Foreground}" 
                                    CornerRadius="3" 
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- En-tête / Barre d'outils -->
            <RowDefinition Height="*"/>    <!-- Split-View central -->
            <RowDefinition Height="Auto"/> <!-- Footer / Barre de statut -->
        </Grid.RowDefinitions>

        <!-- 1. EN-TÊTE / BARRE D'OUTILS -->
        <Border Grid.Row="0" Background="#161619" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Commandes de gauche : Live Sync, Minify, Vider -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnLiveSync" 
                            Style="{StaticResource DarkButtonStyle}" 
                            Click="BtnLiveSync_Click"
                            Margin="0,0,8,0"
                            ToolTip="Active ou met en pause la synchronisation automatique du presse-papiers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtLiveSyncIcon" Text="🔄" Margin="0,0,5,0"/>
                            <TextBlock x:Name="txtLiveSyncLabel" Text="Live Sync : ACTIF" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnMinify" 
                            Style="{StaticResource DarkButtonStyle}" 
                            Click="BtnMinify_Click"
                            Margin="0,0,8,0"
                            ToolTip="Minifie le JSON ou compacte les espaces multiples (Compatible Ctrl+Z pour annuler)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,4,0"/>
                            <TextBlock Text="Minify"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClear" 
                            Style="{StaticResource DarkButtonStyle}" 
                            Click="BtnClear_Click"
                            Margin="0,0,8,0"
                            ToolTip="Efface tout le texte de l'éditeur (Compatible Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,4,0"/>
                            <TextBlock Text="Vider"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Commandes de droite : Découpage, Épingle, Raccourcis -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Seuil :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <ComboBox x:Name="comboChunkSize" 
                              Style="{StaticResource DarkComboBoxStyle}" 
                              SelectionChanged="ComboChunkSize_SelectionChanged"
                              Width="190"
                              Margin="0,0,10,0">
                        <ComboBoxItem Content="250 car. (Scan Ultra-Rapide)" Tag="250"/>
                        <ComboBoxItem Content="400 car. (Équilibré - Défaut)" Tag="400" IsSelected="True"/>
                        <ComboBoxItem Content="600 car. (Haute Densité)" Tag="600"/>
                    </ComboBox>

                    <Button x:Name="btnAlwaysOnTop" 
                            Style="{StaticResource DarkButtonStyle}" 
                            Click="BtnAlwaysOnTop_Click"
                            Margin="0,0,12,0"
                            ToolTip="Garde la fenêtre au-dessus des autres fenêtres (Always on Top)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtPinLabel" Text="Au 1er plan : OUI" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#1F1F24" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Échap = Cacher | Ctrl+Q = Quitter" 
                                   Foreground="{StaticResource TextMuted}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ZONE CENTRALE SPLIT-VIEW (2 COLONNES) -->
        <Grid Grid.Row="1" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne Gauche : Éditeur Texte -->
            <Border Grid.Column="0" 
                    Background="{StaticResource BgCard}" 
                    BorderBrush="{StaticResource BorderCard}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="ÉDITEUR SOURCE" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="txtEditorHint" 
                                   Text="Frappe manuelle = Pause Live Sync" 
                                   HorizontalAlignment="Right" 
                                   FontSize="10" 
                                   Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <TextBox x:Name="txtSource" 
                             Grid.Row="1"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource TextPrimary}"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                             FontSize="13"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="TxtSource_TextChanged"
                             IsUndoEnabled="True"
                             UndoLimit="100"/>
                </Grid>
            </Border>

            <!-- Séparateur visuel -->
            <GridSplitter Grid.Column="1" 
                          Width="4" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="Transparent" 
                          Cursor="SizeWE"/>

            <!-- Colonne Droite : Visualiseur QR Code Pixel-Perfect + Carrousel -->
            <Border Grid.Column="2" 
                    Background="{StaticResource BgCard}" 
                    BorderBrush="{StaticResource BorderCard}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Titre de la carte QR -->
                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="APERÇU QR CODE (SCAN SMARTPHONE)" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="txtEccBadge" 
                                   Text="ECC Level: M" 
                                   HorizontalAlignment="Right" 
                                   FontSize="10" 
                                   Foreground="{StaticResource TextMuted}"/>
                    </Grid>

                    <!-- Pavé Blanc Pur avec QR Code Pixel-Perfect -->
                    <Border Grid.Row="1" 
                            Background="#FFFFFF" 
                            BorderBrush="#4B5563" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="14" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <Image x:Name="imgQrCode"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               SnapsToDevicePixels="True"
                               MinWidth="180" MinHeight="180"
                               MaxWidth="340" MaxHeight="340"/>
                    </Border>

                    <!-- Contrôles du Carrousel de Pagination -->
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="btnPrevPage" 
                                        Style="{StaticResource DarkButtonStyle}" 
                                        Click="BtnPrevPage_Click" 
                                        Padding="8,4" 
                                        Margin="0,0,10,0"
                                        ToolTip="Page précédente (Raccourci : Alt + Flèche Gauche)">
                                    <TextBlock Text="◀ Précédent"/>
                                </Button>

                                <Border Background="#252529" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="12,4" Margin="0,0,10,0">
                                    <TextBlock x:Name="txtPageIndicator" 
                                               Text="Page 1 / 1" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage" 
                                        Style="{StaticResource DarkButtonStyle}" 
                                        Click="BtnNextPage_Click" 
                                        Padding="8,4"
                                        ToolTip="Page suivante (Raccourci : Alt + Flèche Droite)">
                                    <TextBlock Text="Suivant ▶"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Alt + ◀ / ▶" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="10"
                                       Margin="0,0,4,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. FOOTER / BARRE DE STATUT & JAUGE DE DENSITÉ -->
        <Border Grid.Row="2" Background="#161619" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Compteurs temps réel -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatusCounters" 
                               Text="0 caractère | 0 octet UTF-8 | 1 page QR" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="12"/>
                    <TextBlock x:Name="txtChunkRange" 
                               Text=" (Caractères 0 à 0)" 
                               Foreground="{StaticResource TextMuted}" 
                               FontSize="11"/>
                </StackPanel>

                <!-- Jauge de Densité Visuelle et Badge d'Avertissement -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Densité optique :" 
                               Foreground="{StaticResource TextMuted}" 
                               FontSize="11" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"/>

                    <ProgressBar x:Name="progressDensity" 
                                 Style="{StaticResource DensityProgressBarStyle}" 
                                 Width="90" 
                                 Height="8" 
                                 Minimum="0" 
                                 Maximum="600" 
                                 Value="0" 
                                 Foreground="{StaticResource AccentGreen}"
                                 VerticalAlignment="Center" 
                                 Margin="0,0,10,0"/>

                    <Border x:Name="badgeDensity" 
                            Background="#064E3B" 
                            BorderBrush="#059669" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,2">
                        <TextBlock x:Name="txtDensityLabel" 
                                   Text="● Optimal - Scan instantané" 
                                   Foreground="{StaticResource AccentGreen}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
